{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "earthdata-downloader": {
      "root": "earthdata-downloader/",
      "entrypoint": "app.main:app",
      "functions": {
        "app/main.py": {
          "maxDuration": 300,
          "memory": 2048
        }
      }
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "earthdata-downloader"
      }
    }
  ],
  "fluid": true
}
